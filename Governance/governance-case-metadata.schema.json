{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomasweidner/flashgate-mcp/Governance/governance-case-metadata.schema.json",
  "title": "FlashGate canonical governance case metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SchemaVersion",
    "CapabilityCatalog",
    "WindowsOnlyDependencyCatalog",
    "Cases"
  ],
  "properties": {
    "SchemaVersion": { "const": 1 },
    "CapabilityCatalog": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    },
    "WindowsOnlyDependencyCatalog": {
      "type": "array",
      "items": { "$ref": "#/$defs/windowsDependency" }
    },
    "Cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "capabilityIdentifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["linux", "windows"] }
    },
    "identifierArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CapabilityId", "SupportedPlatforms"],
      "properties": {
        "CapabilityId": { "$ref": "#/$defs/capabilityIdentifier" },
        "SupportedPlatforms": { "$ref": "#/$defs/platforms" }
      }
    },
    "windowsDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DependencyId", "RequiredCapability"],
      "properties": {
        "DependencyId": { "$ref": "#/$defs/identifier" },
        "RequiredCapability": { "$ref": "#/$defs/capabilityIdentifier" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Order",
        "CaseId",
        "Group",
        "Tags",
        "SupportedPlatforms",
        "RequiredCapabilities",
        "WindowsOnlyDependency"
      ],
      "properties": {
        "Order": { "type": "integer", "minimum": 1 },
        "CaseId": { "$ref": "#/$defs/identifier" },
        "Group": { "$ref": "#/$defs/identifier" },
        "Tags": { "$ref": "#/$defs/identifierArray" },
        "SupportedPlatforms": { "$ref": "#/$defs/platforms" },
        "RequiredCapabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capabilityIdentifier" }
        },
        "WindowsOnlyDependency": { "$ref": "#/$defs/identifierArray" }
      }
    }
  }
}
