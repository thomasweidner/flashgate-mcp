{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomasweidner/flashgate-mcp/Governance/governance-report-contract.schema.json",
  "title": "FlashGate governance report contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "status",
    "executionMode",
    "reviewStatus",
    "findingIds",
    "closedFindings",
    "findingStatus",
    "run007Status",
    "requiredReviewMode",
    "targetFindingCount",
    "correctedFindingCount",
    "pendingDeltaFindingCount",
    "closedFindingCount",
    "openFindingCount",
    "nextAction",
    "repositoryPaths",
    "referenceOnlyPaths",
    "directInterfacePaths",
    "regressionTestIds",
    "externalPaths",
    "correctionPatchArtifact",
    "correctionPatchSha256",
    "currentDeltaArtifact",
    "currentDeltaSha256",
    "classicReviewReady",
    "commitPreparationApproved",
    "commitAuthorized",
    "queue"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "const": "BL-333/BL-334" },
    "status": { "const": "FOURTH_BUNDLED_CORRECTION_COMPLETE_AWAITING_FOCUSED_DELTA_REVIEW" },
    "executionMode": { "const": "BUNDLED_CORRECTION" },
    "reviewStatus": { "const": "AWAITING_FOCUSED_DELTA_REVIEW" },
    "findingIds": {
      "const": [
        "BL333-BL334-REV-013",
        "BL333-BL334-REV-015"
      ]
    },
    "closedFindings": {
      "const": [
        "BL333-BL334-REV-007",
        "BL333-BL334-REV-008",
        "BL333-BL334-REV-010"
      ]
    },
    "findingStatus": { "const": "CORRECTED_PENDING_DELTA" },
    "run007Status": { "const": "CORRECTED_PENDING_DELTA" },
    "requiredReviewMode": { "const": "FOCUSED_INDEPENDENT_DELTA_REVIEW" },
    "targetFindingCount": { "const": 2 },
    "correctedFindingCount": { "const": 2 },
    "pendingDeltaFindingCount": { "const": 2 },
    "closedFindingCount": { "const": 3 },
    "openFindingCount": { "const": 0 },
    "nextAction": {
      "const": "Perform only the focused independent delta review of BL333-BL334-REV-013 and BL333-BL334-REV-015 with the new verified review package."
    },
    "repositoryPaths": { "$ref": "#/$defs/nonEmptyStringArray" },
    "referenceOnlyPaths": { "$ref": "#/$defs/nonEmptyStringArray" },
    "directInterfacePaths": { "$ref": "#/$defs/nonEmptyStringArray" },
    "regressionTestIds": { "$ref": "#/$defs/nonEmptyStringArray" },
    "externalPaths": { "$ref": "#/$defs/nonEmptyStringArray" },
    "correctionPatchArtifact": { "const": "correction-only.patch" },
    "correctionPatchSha256": { "$ref": "#/$defs/sha256" },
    "currentDeltaArtifact": { "const": "current-delta.patch" },
    "currentDeltaSha256": { "$ref": "#/$defs/sha256" },
    "classicReviewReady": { "const": true },
    "commitPreparationApproved": { "const": false },
    "commitAuthorized": { "const": false },
    "queue": {
      "const": "BL-333/BL-334 -> BL-335 -> BL-251 -> BL-324 -> final documentation convergence -> remove Local Work Register"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
