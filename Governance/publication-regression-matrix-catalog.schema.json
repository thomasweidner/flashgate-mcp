{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomasweidner/flashgate-mcp/Governance/publication-regression-matrix-catalog.schema.json",
  "title": "FlashGate fixed publication regression matrix catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "matrices"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "matrices": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["matrixId", "runner", "resultSchema", "requiredCaseIds", "sourcePaths", "dependencyPaths"],
        "properties": {
          "matrixId": { "type": "string", "minLength": 1 },
          "runner": { "$ref": "#/$defs/path" },
          "resultSchema": { "$ref": "#/$defs/path" },
          "requiredCaseIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^GHP-[A-Z0-9_-]+$" } },
          "sourcePaths": { "$ref": "#/$defs/paths" },
          "dependencyPaths": { "$ref": "#/$defs/paths" }
        }
      }
    }
  },
  "$defs": {
    "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\|.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } }
  }
}
