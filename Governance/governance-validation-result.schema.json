{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomasweidner/flashgate-mcp/Governance/governance-validation-result.schema.json",
  "title": "FlashGate governance validation orchestration result",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "BLOCKED" } }, "required": ["status"] },
      "then": { "properties": { "failureCount": { "const": 0 } } }
    }
  ],
  "required": [
    "schemaVersion",
    "taskId",
    "profile",
    "status",
    "bindings",
    "stageResults",
    "evidenceReuse",
    "stateTransitionMap",
    "profileResults",
    "runnerProcessStartCount",
    "validationExecutionCount",
    "infrastructureOrInvocationFailureCount",
    "fullMatrixRunCount",
    "packageWriteAttemptCount",
    "generatedTaskControllerFileCount",
    "generatedTaskControllerLineCount",
    "readOnlyProbeCount",
    "observedWarningCount",
    "resolvedWarningCount",
    "openWarningCount",
    "warningCount",
    "failureCount"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "pattern": "^BL-(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2,})$" },
    "profile": {
      "enum": [
        "documentation-registration",
        "governance-schema-change",
        "fixture-harness-change",
        "finding-correction",
        "commit-preparation",
        "focused-revalidation",
        "evidence-only-focused-review",
        "post-merge-closure",
        "full-completion"
      ]
    },
    "status": { "enum": ["PASS", "FAIL", "BLOCKED", "CANCELLED"] },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "sourceRepositoryRoot", "worktreeRoot", "baselineCommit", "currentCommit", "expectedTree", "expectedStatusSha256", "actualStatusSha256", "protectedWorktrees", "selectorInventorySha256", "selectionSha256", "resolvedCaseCount"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "sourceRepositoryRoot": { "type": "string", "minLength": 3 },
        "worktreeRoot": { "type": "string", "minLength": 3 },
        "baselineCommit": { "$ref": "#/$defs/commit" },
        "currentCommit": { "$ref": "#/$defs/commit" },
        "expectedTree": { "$ref": "#/$defs/commit" },
        "expectedStatusSha256": { "$ref": "#/$defs/hash" },
        "actualStatusSha256": {
          "oneOf": [
            { "$ref": "#/$defs/hash" },
            { "type": "null" }
          ]
        },
        "protectedWorktrees": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "root", "expectedStatusSha256", "actualStatusSha256", "status"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "root": { "type": "string", "minLength": 3 },
              "expectedStatusSha256": { "$ref": "#/$defs/hash" },
              "actualStatusSha256": {
                "oneOf": [
                  { "$ref": "#/$defs/hash" },
                  { "type": "null" }
                ]
              },
              "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] }
            }
          }
        },
        "selectorInventorySha256": { "$ref": "#/$defs/hash" },
        "selectionSha256": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "resolvedCaseCount": { "type": "integer", "minimum": 0 }
      }
    },
    "stageResults": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["Id", "Phase", "Status", "Diagnostics"],
        "properties": {
          "Id": { "type": "string", "minLength": 1 },
          "Phase": { "enum": ["CHEAP", "SUBORDINATE"] },
          "Status": { "enum": ["PASS", "FAIL", "BLOCKED", "CANCELLED", "NOT_RUN"] },
          "Diagnostics": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "evidenceReuse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reusedIds", "invalidated"],
      "properties": {
        "reusedIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "invalidated": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["Id", "Reasons"],
            "properties": {
              "Id": { "$ref": "#/$defs/id" },
              "Reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "stateTransitionMap": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["Component", "PriorSha256", "CurrentSha256", "Disposition", "Reason"],
        "properties": {
          "Component": { "enum": ["commit", "tree", "working-status", "scope", "selector", "package", "external-inputs", "evidence"] },
          "PriorSha256": { "$ref": "#/$defs/hash" },
          "CurrentSha256": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
          "Disposition": { "enum": ["REUSED", "INVALIDATED"] },
          "Reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "profileResults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["IntendedBaseResult", "MergeBaseResult", "EffectivePRScopeResult", "EffectivePRPatchHash", "IntegrationProjectionResult", "IntegrationProjectionHash", "AuthorizedWriteSetResult", "ForeignProtectedStateResult"],
      "properties": {
        "IntendedBaseResult": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "MergeBaseResult": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "EffectivePRScopeResult": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "EffectivePRPatchHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "IntegrationProjectionResult": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "IntegrationProjectionHash": { "oneOf": [{ "$ref": "#/$defs/commit" }, { "type": "null" }] },
        "AuthorizedWriteSetResult": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "ForeignProtectedStateResult": { "pattern": "^(PASS_[0-9]+_OF_[0-9]+|FAIL|NOT_RUN)$" }
      }
    },
    "runnerProcessStartCount": { "type": "integer", "minimum": 0 },
    "validationExecutionCount": { "type": "integer", "minimum": 0 },
    "infrastructureOrInvocationFailureCount": { "type": "integer", "minimum": 0 },
    "fullMatrixRunCount": { "type": "integer", "minimum": 0, "maximum": 1 },
    "packageWriteAttemptCount": { "type": "integer", "minimum": 0, "maximum": 1 },
    "generatedTaskControllerFileCount": { "type": "integer", "minimum": 0 },
    "generatedTaskControllerLineCount": { "type": "integer", "minimum": 0 },
    "readOnlyProbeCount": { "type": "integer", "minimum": 0 },
    "observedWarningCount": { "type": "integer", "minimum": 0 },
    "resolvedWarningCount": { "type": "integer", "minimum": 0 },
    "openWarningCount": { "type": "integer", "minimum": 0 },
    "warningCount": { "type": "integer", "minimum": 0 },
    "failureCount": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
  }
}
