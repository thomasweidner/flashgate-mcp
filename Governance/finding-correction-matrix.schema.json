{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomasweidner/flashgate-mcp/Governance/finding-correction-matrix.schema.json",
  "title": "FlashGate finding correction matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "previousReviewPackage",
    "previousReviewSha256",
    "correctedFindingCount",
    "repositoryCorrectionPaths",
    "findings"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "mode": { "const": "BUNDLED_CORRECTION" },
    "previousReviewPackage": { "type": "string", "minLength": 1 },
    "previousReviewSha256": { "$ref": "#/$defs/sha256" },
    "correctedFindingCount": { "type": "integer", "minimum": 1 },
    "repositoryCorrectionPaths": { "$ref": "#/$defs/nonEmptyStringArray" },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "previousStatus",
        "status",
        "disposition",
        "correction",
        "affectedPaths",
        "regressionTestIds",
        "evidenceReferences"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/findingId" },
        "severity": { "enum": ["BLOCKER", "MAJOR", "MINOR", "NOTE"] },
        "previousStatus": {
          "enum": ["OPEN", "PARTIALLY_CLOSED", "PARTIALLY_CLOSED_CORRECTION_REQUIRED"]
        },
        "status": { "const": "CORRECTED_PENDING_DELTA" },
        "disposition": { "const": "CORRECTED" },
        "correction": { "type": "string", "minLength": 1 },
        "affectedPaths": { "$ref": "#/$defs/nonEmptyStringArray" },
        "regressionTestIds": { "$ref": "#/$defs/nonEmptyStringArray" },
        "evidenceReferences": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "findingId": {
      "type": "string",
      "pattern": "^BL-(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2,})-REV-0*[1-9][0-9]*$"
    }
  }
}
