{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomasweidner/flashgate-mcp/Governance/generic-completion-report.schema.json",
  "title": "FlashGate generic commit-preparation completion report",
  "type": "object",
  "allOf": [
    { "if": { "properties": { "classicReviewReady": { "const": true } }, "required": ["classicReviewReady"] }, "then": { "properties": { "status": { "const": "CLASSIC_REVIEW_READY" }, "zipFreeReadinessPassed": { "const": true }, "openWarningCount": { "const": 0 }, "warningCount": { "const": 0 }, "failureCount": { "const": 0 } } } },
    { "if": { "properties": { "classicReviewReady": { "const": false } }, "required": ["classicReviewReady"] }, "then": { "properties": { "status": { "const": "NOT_CLASSIC_REVIEW_READY" } } } },
    {
      "if": { "properties": { "profile": { "const": "GENERIC_COMMIT_PREPARATION" } }, "required": ["profile"] },
      "then": {
        "properties": { "transitionType": { "const": "COMMIT_PREPARATION_TO_COMMIT_APPROVAL" }, "branch": { "type": "string", "minLength": 1 } },
        "not": { "anyOf": [
          { "required": ["independentReviewStatus"] },
          { "required": ["fullCompletionEvidenceSha256"] },
          { "required": ["fullCompletionResultSha256"] },
          { "required": ["executionEnvelopeSha256"] }
        ] }
      }
    },
    {
      "if": { "properties": { "profile": { "const": "IMPLEMENTATION_TO_INDEPENDENT_FULL_REVIEW" } }, "required": ["profile"] },
      "then": {
        "required": ["independentReviewStatus", "fullCompletionEvidenceSha256", "fullCompletionResultSha256", "executionEnvelopeSha256"],
        "properties": {
          "transitionType": { "const": "IMPLEMENTATION_TO_INDEPENDENT_FULL_REVIEW" },
          "independentReviewStatus": { "const": "NOT_PERFORMED" },
          "branch": { "type": "string" }
        }
      }
    }
  ],
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "repository", "baselineCommit", "currentCommit", "branch", "profile", "transitionType", "status", "currentStateGate", "classicReviewReady", "findingIds", "commitAuthorized", "materialCorrectionCycleCount", "validationExecutionCount", "infrastructureOrInvocationFailureCount", "observedWarningCount", "resolvedWarningCount", "openWarningCount", "warningCount", "failureCount", "zipFreeReadinessPassed", "packageGeneration", "scopeInventorySha256", "taskPatchSha256", "currentDeltaSha256", "allowedDeltaPaths", "excludedDeltaPaths", "nextAction"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "pattern": "^BL-[0-9]{3}$" },
    "repository": { "const": "https://github.com/thomasweidner/flashgate-mcp.git" },
    "baselineCommit": { "$ref": "#/$defs/commit" },
    "currentCommit": { "$ref": "#/$defs/commit" },
    "branch": { "type": "string" },
    "profile": { "enum": ["GENERIC_COMMIT_PREPARATION", "IMPLEMENTATION_TO_INDEPENDENT_FULL_REVIEW"] },
    "transitionType": { "enum": ["COMMIT_PREPARATION_TO_COMMIT_APPROVAL", "IMPLEMENTATION_TO_INDEPENDENT_FULL_REVIEW"] },
    "status": { "enum": ["CLASSIC_REVIEW_READY", "NOT_CLASSIC_REVIEW_READY"] },
    "currentStateGate": { "$ref": "#/$defs/currentStateGate" },
    "classicReviewReady": { "type": "boolean" },
    "findingIds": { "$ref": "#/$defs/findingIds" },
    "commitAuthorized": { "const": false },
    "materialCorrectionCycleCount": { "type": "integer", "minimum": 0 },
    "validationExecutionCount": { "type": "integer", "minimum": 1 },
    "infrastructureOrInvocationFailureCount": { "type": "integer", "minimum": 0 },
    "observedWarningCount": { "type": "integer", "minimum": 0 },
    "resolvedWarningCount": { "type": "integer", "minimum": 0 },
    "openWarningCount": { "type": "integer", "minimum": 0 },
    "warningCount": { "type": "integer", "minimum": 0 },
    "failureCount": { "type": "integer", "minimum": 0 },
    "zipFreeReadinessPassed": { "type": "boolean" },
    "packageGeneration": { "$ref": "#/$defs/packageGeneration" },
    "scopeInventorySha256": { "$ref": "#/$defs/hash" },
    "taskPatchSha256": { "$ref": "#/$defs/hash" },
    "currentDeltaSha256": { "$ref": "#/$defs/hash" },
    "allowedDeltaPaths": { "$ref": "#/$defs/pathArray" },
    "excludedDeltaPaths": { "$ref": "#/$defs/pathArray" },
    "nextAction": { "type": "string", "minLength": 1 },
    "independentReviewStatus": { "const": "NOT_PERFORMED" },
    "fullCompletionEvidenceSha256": { "$ref": "#/$defs/hash" },
    "fullCompletionResultSha256": { "$ref": "#/$defs/hash" },
    "executionEnvelopeSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\|.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "pathArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "findingIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" } },
    "currentStateGate": {
      "type": "object", "additionalProperties": false,
      "required": ["result", "repositoryIdentityBound", "commitAndBranchBound", "completeStatusBound", "scopeAndIdsBound", "parallelWorktreesBound"],
      "properties": {
        "result": { "const": "PASS" }, "repositoryIdentityBound": { "const": true },
        "commitAndBranchBound": { "const": true }, "completeStatusBound": { "const": true },
        "scopeAndIdsBound": { "const": true }, "parallelWorktreesBound": { "const": true }
      }
    },
    "packageGeneration": {
      "type": "object", "additionalProperties": false,
      "required": ["freshStaging", "finalZipWriteCount", "inPlaceRepairPerformed"],
      "properties": {
        "freshStaging": { "const": true },
        "finalZipWriteCount": { "const": 1 },
        "inPlaceRepairPerformed": { "const": false }
      }
    }
  }
}
