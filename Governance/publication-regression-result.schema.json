{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomasweidner/flashgate-mcp/Governance/publication-regression-result.schema.json",
  "title": "FlashGate publication regression execution result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "matrixId", "executionInputBinding", "status", "selected", "passed", "failed", "results", "failureMessage"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "matrixId": { "type": "string", "minLength": 1 },
    "executionInputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrixDefinitionArtifact", "matrixDefinitionSha256", "sourceBindings", "dependencyBindings"],
      "properties": {
        "matrixDefinitionArtifact": { "const": "Governance/publication-regression-matrix-catalog.json" },
        "matrixDefinitionSha256": { "$ref": "#/$defs/sha256" },
        "sourceBindings": { "$ref": "#/$defs/fileBindings" },
        "dependencyBindings": { "$ref": "#/$defs/fileBindings" }
      }
    },
    "status": { "enum": ["PASS", "FAIL"] },
    "selected": { "type": "integer", "minimum": 0 },
    "passed": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "results": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^GHP-[A-Z0-9_-]+$" },
          "result": { "enum": ["PASS", "FAIL"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "failureMessage": { "type": ["string", "null"] }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\|.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "fileBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  }
}
