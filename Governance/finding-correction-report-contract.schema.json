{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomasweidner/flashgate-mcp/Governance/finding-correction-report-contract.schema.json",
  "title": "FlashGate finding-correction embedded report contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "profile",
    "transitionType",
    "artifactLifecycleState",
    "status",
    "readyToExecute",
    "previousReview",
    "currentFeaturePatch",
    "correctionOnlyPatch",
    "findingIds",
    "findingDispositions",
    "scopeSemantics",
    "permanentRegressionEvidence",
    "focusedValidationResult",
    "independentDeltaReviewRequired",
    "classicReviewReady",
    "packageWriteAttemptCount",
    "nextAction"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "artifactLifecycleState": { "const": "ZIP_FREE_READY_TO_EXECUTE" } },
        "required": ["artifactLifecycleState"]
      },
      "then": {
        "properties": {
          "status": { "const": "ZIP_FREE_READY_TO_EXECUTE" },
          "readyToExecute": { "const": true },
          "classicReviewReady": { "const": false },
          "packageWriteAttemptCount": { "const": 0 },
          "nextAction": { "const": "READY_FOR_SINGLE_DELTA_REVIEW_PACKAGE_WRITE_AUTHORIZATION" }
        }
      }
    },
    {
      "if": {
        "properties": { "artifactLifecycleState": { "const": "FINAL_REVIEW_PACKAGE" } },
        "required": ["artifactLifecycleState"]
      },
      "then": {
        "properties": {
          "status": { "const": "FINAL_REVIEW_PACKAGE" },
          "readyToExecute": { "const": false },
          "classicReviewReady": { "const": true },
          "packageWriteAttemptCount": { "const": 1 },
          "nextAction": { "const": "FOCUSED_INDEPENDENT_DELTA_REVIEW" }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "pattern": "^BL-[0-9]{3}$" },
    "profile": { "const": "FINDING_CORRECTION" },
    "transitionType": { "const": "BUNDLED_CORRECTION_TO_FOCUSED_DELTA_REVIEW" },
    "artifactLifecycleState": { "enum": ["ZIP_FREE_READY_TO_EXECUTE", "FINAL_REVIEW_PACKAGE"] },
    "status": { "enum": ["ZIP_FREE_READY_TO_EXECUTE", "FINAL_REVIEW_PACKAGE"] },
    "readyToExecute": { "type": "boolean" },
    "previousReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateType", "reviewStateSha256", "bindingArtifact", "bindingSha256"],
      "properties": {
        "stateType": { "enum": ["COMMIT", "IMMUTABLE_REVIEW_PACKAGE"] },
        "reviewStateSha256": { "$ref": "#/$defs/sha256" },
        "bindingArtifact": { "const": "previous-review-binding.json" },
        "bindingSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "currentFeaturePatch": { "$ref": "#/$defs/patchBinding" },
    "correctionOnlyPatch": { "$ref": "#/$defs/patchBinding" },
    "findingIds": { "$ref": "#/$defs/findingIds" },
    "findingDispositions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "previousStatus", "status", "disposition", "correction", "affectedPaths", "regressionTestIds", "evidenceReferences", "producerStatus", "reviewerStatus"],
        "properties": {
          "id": { "$ref": "#/$defs/findingId" },
          "severity": { "enum": ["BLOCKER", "MAJOR", "MINOR", "NOTE"] },
          "previousStatus": { "enum": ["OPEN", "PARTIALLY_CLOSED", "PARTIALLY_CLOSED_CORRECTION_REQUIRED"] },
          "status": { "const": "CORRECTED_PENDING_DELTA" },
          "disposition": { "const": "CORRECTED" },
          "correction": { "type": "string", "minLength": 1 },
          "affectedPaths": { "$ref": "#/$defs/nonEmptyStrings" },
          "regressionTestIds": { "$ref": "#/$defs/nonEmptyStrings" },
          "evidenceReferences": { "$ref": "#/$defs/nonEmptyStrings" },
          "producerStatus": { "const": "CORRECTED_PENDING_DELTA_REVIEW" },
          "reviewerStatus": { "const": "OPEN_PENDING_FOCUSED_INDEPENDENT_DELTA_REVIEW" }
        }
      }
    },
    "scopeSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correctionOnlyPaths", "directInterfacePaths", "referenceOnlyPaths"],
      "properties": {
        "correctionOnlyPaths": { "$ref": "#/$defs/paths" },
        "directInterfacePaths": { "$ref": "#/$defs/paths" },
        "referenceOnlyPaths": { "$ref": "#/$defs/paths" }
      }
    },
    "permanentRegressionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testIds", "result"],
      "properties": {
        "testIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "result": { "const": "PASS" }
      }
    },
    "focusedValidationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "selected", "passed"],
      "properties": {
        "result": { "const": "PASS" },
        "selected": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 1 }
      }
    },
    "independentDeltaReviewRequired": { "const": true },
    "classicReviewReady": { "type": "boolean" },
    "packageWriteAttemptCount": { "enum": [0, 1] },
    "publicationRegressionEvidence": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/publicationEvidenceBinding" }
    },
    "nextAction": { "enum": ["READY_FOR_SINGLE_DELTA_REVIEW_PACKAGE_WRITE_AUTHORIZATION", "FOCUSED_INDEPENDENT_DELTA_REVIEW"] }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "findingId": { "type": "string", "pattern": "^BL[0-9]{3}(?:-BL[0-9]{3})?(?:-[A-Z][A-Z0-9]*)*-REV-[0-9]{3}$" },
    "findingIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/findingId" }
    },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyStrings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "publicationEvidenceBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["findingId", "artifact", "sha256", "matrixId", "caseIds"],
      "properties": {
        "findingId": { "$ref": "#/$defs/findingId" },
        "artifact": { "const": "publication-regression-evidence.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "matrixId": { "type": "string", "minLength": 1 },
        "caseIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^GHP-[A-Z0-9_-]+$" } }
      }
    },
    "patchBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "sha256", "pathCount"],
      "properties": {
        "artifact": { "enum": ["current-delta.patch", "correction-only.patch"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "pathCount": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
