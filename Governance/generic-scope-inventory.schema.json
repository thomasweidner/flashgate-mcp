{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomasweidner/flashgate-mcp/Governance/generic-scope-inventory.schema.json",
  "title": "FlashGate generic scope and current-state inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "profile", "repository", "baselineCommit", "currentCommit", "branch", "allowedDeltaPaths", "excludedDeltaPaths", "entries", "hostPathPolicy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "pattern": "^BL-[0-9]{3}$" },
    "profile": { "const": "GENERIC_COMMIT_PREPARATION" },
    "repository": { "const": "https://github.com/thomasweidner/flashgate-mcp.git" },
    "baselineCommit": { "$ref": "#/$defs/commit" },
    "currentCommit": { "$ref": "#/$defs/commit" },
    "branch": { "type": "string", "minLength": 1 },
    "allowedDeltaPaths": { "$ref": "#/$defs/pathArray" },
    "excludedDeltaPaths": { "$ref": "#/$defs/pathArray" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/trackedPostimageEntry" },
          { "$ref": "#/$defs/untrackedPostimageEntry" },
          { "$ref": "#/$defs/deletedEntry" },
          { "$ref": "#/$defs/renamedEntry" }
        ]
      }
    },
    "hostPathPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostPathFreeArtifacts", "allowedReferences"],
      "properties": {
        "hostPathFreeArtifacts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/scannedArtifact" } },
        "allowedReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact", "path", "classification", "reason"],
            "properties": {
              "artifact": { "$ref": "#/$defs/scannedArtifact" },
              "path": { "type": "string", "pattern": "^(?:[A-Za-z]:\\\\|\\\\\\\\|/).+" },
              "classification": { "enum": ["CANONICAL_INFRASTRUCTURE", "DOCUMENTED_EXAMPLE", "SYNTHETIC_FIXTURE"] },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\|.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "pathArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "regularFileMode": { "type": "string", "enum": ["100644", "100755"] },
    "preimage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "mode", "modeSource", "length", "sha256"],
      "properties": {
        "commit": { "$ref": "#/$defs/commit" },
        "mode": { "$ref": "#/$defs/regularFileMode" },
        "modeSource": { "const": "BASELINE_TREE" },
        "length": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "trackedPostimage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "modeSource", "length", "sha256"],
      "properties": {
        "mode": { "$ref": "#/$defs/regularFileMode" },
        "modeSource": { "const": "GIT_WORKTREE" },
        "length": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "untrackedPostimage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "modeSource", "length", "sha256"],
      "properties": {
        "mode": { "$ref": "#/$defs/regularFileMode" },
        "modeSource": { "enum": ["WINDOWS_REGULAR_FILE_NORMALIZED", "UNIX_EXECUTABLE_BIT_NORMALIZED"] },
        "length": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "trackedPostimageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "gitStatus", "tracked", "staged", "postimage", "inclusionDecision", "reason"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "gitStatus": { "enum": ["TRACKED_MODIFIED", "TRACKED_ADDED", "TRACKED_MODE_CHANGED"] },
        "tracked": { "const": true },
        "staged": { "const": false },
        "postimage": { "$ref": "#/$defs/trackedPostimage" },
        "inclusionDecision": { "enum": ["INCLUDE", "EXCLUDE"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "untrackedPostimageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "gitStatus", "tracked", "staged", "postimage", "inclusionDecision", "reason"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "gitStatus": { "const": "UNTRACKED" },
        "tracked": { "const": false },
        "staged": { "const": false },
        "postimage": { "$ref": "#/$defs/untrackedPostimage" },
        "inclusionDecision": { "enum": ["INCLUDE", "EXCLUDE"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "deletedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "gitStatus", "tracked", "staged", "preimage", "postimageAbsent", "inclusionDecision", "reason"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "gitStatus": { "const": "TRACKED_DELETED" },
        "tracked": { "const": true },
        "staged": { "const": false },
        "preimage": { "$ref": "#/$defs/preimage" },
        "postimageAbsent": { "const": true },
        "inclusionDecision": { "enum": ["INCLUDE", "EXCLUDE"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "renamedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previousPath", "path", "gitStatus", "tracked", "staged", "preimage", "postimage", "inclusionDecision", "reason"],
      "properties": {
        "previousPath": { "$ref": "#/$defs/path" },
        "path": { "$ref": "#/$defs/path" },
        "gitStatus": { "const": "TRACKED_RENAMED" },
        "tracked": { "const": true },
        "staged": { "const": false },
        "preimage": { "$ref": "#/$defs/preimage" },
        "postimage": { "$ref": "#/$defs/trackedPostimage" },
        "inclusionDecision": { "enum": ["INCLUDE", "EXCLUDE"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "scannedArtifact": { "enum": ["HANDOFF.md", "assignment-record.json", "completion-report.json", "current-delta.patch", "independent-review-evidence.json", "report.md", "task.patch", "validation-summary.json"] }
  }
}
