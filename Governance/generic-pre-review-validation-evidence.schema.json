{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomasweidner/flashgate-mcp/Governance/generic-pre-review-validation-evidence.schema.json",
  "title": "FlashGate implementation-to-independent-full-review validation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "taskId", "repository", "baselineCommit", "currentCommit",
    "branch", "profile", "evidenceType", "independentReviewStatus",
    "externalArtifactRequired", "fullCompletionStatus", "stagePassed",
    "stageSelected", "fullCompletionEvidenceReused", "fullCompletionReexecuted",
    "fullMatrixRunCount", "productionRunInvocationCount", "automaticRetryCount",
    "infrastructureOrInvocationFailureCount", "openInfrastructureFindingCount",
    "warningCount", "failureCount", "packageWriteAttemptCountBeforeHandoff",
    "fullCompletionResultSha256", "executionEnvelopeSha256", "findingIds",
    "scopeInventorySha256", "allowedDeltaPaths", "excludedDeltaPaths"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "pattern": "^BL-[0-9]{3}$" },
    "repository": { "const": "https://github.com/thomasweidner/flashgate-mcp.git" },
    "baselineCommit": { "$ref": "#/$defs/commit" },
    "currentCommit": { "$ref": "#/$defs/commit" },
    "branch": { "type": "string" },
    "profile": { "const": "IMPLEMENTATION_TO_INDEPENDENT_FULL_REVIEW" },
    "evidenceType": { "const": "FULL_COMPLETION_REUSE" },
    "independentReviewStatus": { "const": "NOT_PERFORMED" },
    "externalArtifactRequired": { "const": false },
    "fullCompletionStatus": { "const": "PASS" },
    "stagePassed": { "type": "integer", "minimum": 1 },
    "stageSelected": { "type": "integer", "minimum": 1 },
    "fullCompletionEvidenceReused": { "const": true },
    "fullCompletionReexecuted": { "const": false },
    "fullMatrixRunCount": { "const": 1 },
    "productionRunInvocationCount": { "const": 1 },
    "automaticRetryCount": { "const": 0 },
    "infrastructureOrInvocationFailureCount": { "const": 0 },
    "openInfrastructureFindingCount": { "const": 0 },
    "warningCount": { "const": 0 },
    "failureCount": { "const": 0 },
    "packageWriteAttemptCountBeforeHandoff": { "const": 0 },
    "fullCompletionResultSha256": { "$ref": "#/$defs/hash" },
    "executionEnvelopeSha256": { "$ref": "#/$defs/hash" },
    "findingIds": { "$ref": "#/$defs/findingIds" },
    "scopeInventorySha256": { "$ref": "#/$defs/hash" },
    "allowedDeltaPaths": { "$ref": "#/$defs/pathArray" },
    "excludedDeltaPaths": { "$ref": "#/$defs/pathArray" }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\|.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "pathArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "findingIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" } }
  }
}
