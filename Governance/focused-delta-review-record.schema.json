{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomasweidner/flashgate-mcp/Governance/focused-delta-review-record.schema.json",
  "title": "FlashGate focused delta review record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "previousReviewPackage",
    "previousReviewSha256",
    "correctionPatchArtifact",
    "correctionPatchSha256",
    "currentDeltaArtifact",
    "currentDeltaSha256",
    "correctionOnlyPaths",
    "reviewedFindingIds",
    "directInterfacePaths",
    "regressionTestIds",
    "allowedDeltaPaths",
    "referenceOnlyPaths",
    "fullReviewRepeatAuthorized",
    "commitPreparationApproved",
    "commitAuthorized"
  ],
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 2 } }, "required": ["schemaVersion"] },
      "then": {
        "required": ["correctionStartCommit"],
        "not": { "required": ["previousReviewState"] }
      }
    },
    {
      "if": { "properties": { "schemaVersion": { "const": 3 } }, "required": ["schemaVersion"] },
      "then": {
        "required": ["previousReviewState"],
        "not": { "required": ["correctionStartCommit"] }
      }
    }
  ],
  "properties": {
    "schemaVersion": { "enum": [2, 3] },
    "mode": { "const": "FOCUSED_INDEPENDENT_DELTA_REVIEW" },
    "previousReviewPackage": { "type": "string", "minLength": 1 },
    "previousReviewSha256": { "$ref": "#/$defs/sha256" },
    "previousIndependentReviewOutcomeSha256": { "$ref": "#/$defs/outcomeSha256" },
    "correctionStartCommit": { "$ref": "#/$defs/commit" },
    "previousReviewState": { "oneOf": [
      { "$ref": "#/$defs/commitState" },
      { "$ref": "#/$defs/immutablePackageState" }
    ] },
    "correctionPatchArtifact": { "const": "correction-only.patch" },
    "correctionPatchSha256": { "$ref": "#/$defs/sha256" },
    "currentDeltaArtifact": { "const": "current-delta.patch" },
    "currentDeltaSha256": { "$ref": "#/$defs/sha256" },
    "correctionOnlyPaths": { "$ref": "#/$defs/nonEmptyPathArray" },
    "reviewedFindingIds": { "$ref": "#/$defs/nonEmptyFindingIdArray" },
    "directInterfacePaths": { "$ref": "#/$defs/nonEmptyPathArray" },
    "regressionTestIds": { "$ref": "#/$defs/nonEmptyStringArray" },
    "allowedDeltaPaths": { "$ref": "#/$defs/nonEmptyPathArray" },
    "referenceOnlyPaths": { "$ref": "#/$defs/nonEmptyPathArray" },
    "fullReviewRepeatAuthorized": { "const": false },
    "commitPreparationApproved": { "const": false },
    "commitAuthorized": { "const": false }
    ,"publicationRegressionEvidence": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/publicationEvidenceBinding" }
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "outcomeSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "path": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:|/|\\\\|.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "findingId": {
      "type": "string",
      "pattern": "^BL-(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2,})-REV-0*[1-9][0-9]*$"
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyPathArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "nonEmptyFindingIdArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/findingId" }
    },
    "publicationEvidenceBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["findingId", "artifact", "sha256", "matrixId", "caseIds"],
      "properties": {
        "findingId": { "$ref": "#/$defs/findingId" },
        "artifact": { "const": "publication-regression-evidence.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "matrixId": { "type": "string", "minLength": 1 },
        "caseIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^GHP-[A-Z0-9_-]+$" } }
      }
    },
    "commitState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "correctionStartCommit"],
      "properties": {
        "type": { "const": "COMMIT" },
        "correctionStartCommit": { "$ref": "#/$defs/commit" }
      }
    },
    "immutablePackageState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "historicalPackageSha256",
        "historicalManifestSha256",
        "historicalPatchSha256",
        "historicalScopeInventorySha256",
        "previousReviewedBaselineCommit",
        "previousReviewedTree",
        "previousReviewedPathCount",
        "previousReviewedPostimages"
      ],
      "properties": {
        "type": { "const": "IMMUTABLE_REVIEW_PACKAGE" },
        "historicalPackageSha256": { "$ref": "#/$defs/sha256" },
        "historicalManifestSha256": { "$ref": "#/$defs/sha256" },
        "historicalPatchSha256": { "$ref": "#/$defs/sha256" },
        "historicalScopeInventorySha256": { "$ref": "#/$defs/sha256" },
        "previousReviewedBaselineCommit": { "$ref": "#/$defs/commit" },
        "previousReviewedTree": { "$ref": "#/$defs/commit" },
        "previousReviewedPathCount": { "type": "integer", "minimum": 1 },
        "previousReviewedPostimages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/previousPostimage" }
        }
      }
    },
    "previousPostimage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "presence", "mode", "length", "sha256"],
          "properties": {
            "path": { "$ref": "#/$defs/path" },
            "presence": { "const": "PRESENT" },
            "mode": { "enum": ["100644", "100755"] },
            "length": { "type": "integer", "minimum": 0 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "presence"],
          "properties": {
            "path": { "$ref": "#/$defs/path" },
            "presence": { "const": "ABSENT" }
          }
        }
      ]
    }
  }
}
