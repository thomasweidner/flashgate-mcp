{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomasweidner/flashgate-mcp/Governance/finding-correction-assignment.schema.json",
  "title": "FlashGate finding-correction handoff assignment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "repository", "baselineCommit", "currentCommit", "branch", "executionMode", "checkpoint", "profile", "transitionType", "currentStateGate", "findingIds", "classicReviewReady", "commitAuthorized", "scopeInventorySha256", "correctionScopeInventorySha256", "currentDeltaSha256", "correctionPatchSha256", "findingLedgerSha256", "previousReviewBindingSha256", "allowedDeltaPaths", "correctionOnlyPaths", "directInterfacePaths", "nextAction"],
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 1 } }, "required": ["schemaVersion"] },
      "then": {
        "properties": {
          "classicReviewReady": { "const": false },
          "nextAction": { "const": "READY_FOR_SINGLE_DELTA_REVIEW_PACKAGE_WRITE_AUTHORIZATION" }
        },
        "not": { "required": ["artifactLifecycleState"] }
      }
    },
    {
      "if": { "properties": { "schemaVersion": { "const": 2 } }, "required": ["schemaVersion"] },
      "then": { "required": ["artifactLifecycleState", "readyToExecute"] }
    },
    {
      "if": { "properties": { "artifactLifecycleState": { "const": "ZIP_FREE_READY_TO_EXECUTE" } }, "required": ["artifactLifecycleState"] },
      "then": {
        "properties": {
          "readyToExecute": { "const": true },
          "classicReviewReady": { "const": false },
          "nextAction": { "const": "READY_FOR_SINGLE_DELTA_REVIEW_PACKAGE_WRITE_AUTHORIZATION" }
        }
      }
    },
    {
      "if": { "properties": { "artifactLifecycleState": { "const": "FINAL_REVIEW_PACKAGE" } }, "required": ["artifactLifecycleState"] },
      "then": {
        "properties": {
          "readyToExecute": { "const": false },
          "classicReviewReady": { "const": true },
          "nextAction": { "const": "FOCUSED_INDEPENDENT_DELTA_REVIEW" }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "artifactLifecycleState": { "enum": ["ZIP_FREE_READY_TO_EXECUTE", "FINAL_REVIEW_PACKAGE"] },
    "readyToExecute": { "type": "boolean" },
    "taskId": { "type": "string", "pattern": "^BL-[0-9]{3}$" },
    "repository": { "const": "https://github.com/thomasweidner/flashgate-mcp.git" },
    "baselineCommit": { "$ref": "#/$defs/commit" },
    "currentCommit": { "$ref": "#/$defs/commit" },
    "branch": { "type": "string" },
    "executionMode": { "const": "BUNDLED_CORRECTION" },
    "checkpoint": { "enum": ["ASSIGNMENT_START", "MATERIAL_SCOPE_CHANGE", "SPRINT_CLOSE"] },
    "profile": { "const": "FINDING_CORRECTION" },
    "transitionType": { "const": "BUNDLED_CORRECTION_TO_FOCUSED_DELTA_REVIEW" },
    "currentStateGate": {
      "type": "object", "additionalProperties": false,
      "required": ["result", "repositoryIdentityBound", "commitAndBranchBound", "completeStatusBound", "scopeAndIdsBound", "parallelWorktreesBound"],
      "properties": {
        "result": { "const": "PASS" }, "repositoryIdentityBound": { "const": true },
        "commitAndBranchBound": { "const": true }, "completeStatusBound": { "const": true },
        "scopeAndIdsBound": { "const": true }, "parallelWorktreesBound": { "const": true }
      }
    },
    "findingIds": { "$ref": "#/$defs/findingIds" },
    "classicReviewReady": { "type": "boolean" },
    "commitAuthorized": { "const": false },
    "scopeInventorySha256": { "$ref": "#/$defs/hash" },
    "correctionScopeInventorySha256": { "$ref": "#/$defs/hash" },
    "currentDeltaSha256": { "$ref": "#/$defs/hash" },
    "correctionPatchSha256": { "$ref": "#/$defs/hash" },
    "findingLedgerSha256": { "$ref": "#/$defs/hash" },
    "previousReviewBindingSha256": { "$ref": "#/$defs/hash" },
    "previousIndependentReviewOutcomeSha256": { "$ref": "#/$defs/outcomeHash" },
    "allowedDeltaPaths": { "$ref": "#/$defs/paths" },
    "correctionOnlyPaths": { "$ref": "#/$defs/paths" },
    "directInterfacePaths": { "$ref": "#/$defs/paths" },
    "nextAction": { "enum": ["READY_FOR_SINGLE_DELTA_REVIEW_PACKAGE_WRITE_AUTHORIZATION", "FOCUSED_INDEPENDENT_DELTA_REVIEW"] }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "outcomeHash": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\|.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "findingIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^BL[0-9]{3}(?:-BL[0-9]{3})?(?:-[A-Z][A-Z0-9]*)*-REV-[0-9]{3}$" } }
  }
}
