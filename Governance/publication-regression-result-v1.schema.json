{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomasweidner/flashgate-mcp/Governance/publication-regression-result-v1.schema.json",
  "title": "FlashGate historical publication regression execution result V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "matrixId", "status", "selected", "passed", "failed", "results", "failureMessage"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "matrixId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["PASS", "FAIL"] },
    "selected": { "type": "integer", "minimum": 0 },
    "passed": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^GHP-[A-Z0-9_-]+$" },
          "result": { "enum": ["PASS", "FAIL"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "failureMessage": { "type": ["string", "null"] }
  }
}
