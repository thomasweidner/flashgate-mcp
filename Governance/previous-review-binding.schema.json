{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomasweidner/flashgate-mcp/Governance/previous-review-binding.schema.json",
  "title": "FlashGate previous-review state binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId"],
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 2 } }, "required": ["schemaVersion"] },
      "then": {
        "required": ["previousReviewStateType", "historicalPackagePath", "historicalPackageSha256", "historicalManifestSha256", "historicalPatchSha256", "historicalScopeInventorySha256", "previousReviewedBaselineCommit", "previousReviewedTree", "previousReviewedPathCount", "previousReviewedPostimages"],
        "not": { "required": ["previousReviewState"] }
      }
    },
    {
      "if": { "properties": { "schemaVersion": { "const": 3 } }, "required": ["schemaVersion"] },
      "then": {
        "required": ["previousReviewState"],
        "not": { "anyOf": [
          { "required": ["previousReviewStateType"] },
          { "required": ["historicalPackagePath"] },
          { "required": ["previousReviewedTree"] }
        ] }
      }
    }
  ],
  "properties": {
    "schemaVersion": { "enum": [2, 3] },
    "taskId": { "type": "string", "pattern": "^BL-(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2,})$" },
    "previousReviewStateType": { "const": "IMMUTABLE_REVIEW_PACKAGE" },
    "historicalPackagePath": { "type": "string", "minLength": 1 },
    "historicalPackageSha256": { "$ref": "#/$defs/hash" },
    "historicalManifestSha256": { "$ref": "#/$defs/hash" },
    "historicalPatchSha256": { "$ref": "#/$defs/hash" },
    "historicalScopeInventorySha256": { "$ref": "#/$defs/hash" },
    "previousReviewedBaselineCommit": { "$ref": "#/$defs/commit" },
    "previousReviewedTree": { "$ref": "#/$defs/commit" },
    "previousReviewedPathCount": { "type": "integer", "minimum": 1 },
    "previousReviewedPostimages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/postimage" } },
    "previousReviewState": { "oneOf": [
      { "$ref": "#/$defs/commitState" },
      { "$ref": "#/$defs/immutablePackageState" }
    ] }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\|.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "commitState": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "correctionStartCommit", "previousReviewedTree"],
      "properties": {
        "type": { "const": "COMMIT" },
        "correctionStartCommit": { "$ref": "#/$defs/commit" },
        "previousReviewedTree": { "$ref": "#/$defs/commit" }
      }
    },
    "immutablePackageState": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "historicalPackagePath", "historicalPackageSha256", "historicalManifestSha256", "historicalPatchSha256", "historicalScopeInventorySha256", "previousReviewedBaselineCommit", "previousReviewedTree", "previousReviewedPathCount", "previousReviewedPostimages"],
      "properties": {
        "type": { "const": "IMMUTABLE_REVIEW_PACKAGE" },
        "historicalPackagePath": { "type": "string", "minLength": 1 },
        "historicalPackageSha256": { "$ref": "#/$defs/hash" },
        "historicalManifestSha256": { "$ref": "#/$defs/hash" },
        "historicalPatchSha256": { "$ref": "#/$defs/hash" },
        "historicalScopeInventorySha256": { "$ref": "#/$defs/hash" },
        "previousReviewedBaselineCommit": { "$ref": "#/$defs/commit" },
        "previousReviewedTree": { "$ref": "#/$defs/commit" },
        "previousReviewedPathCount": { "type": "integer", "minimum": 1 },
        "previousReviewedPostimages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/postimage" } }
      }
    },
    "postimage": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["path", "presence", "mode", "length", "sha256"], "properties": { "path": { "$ref": "#/$defs/path" }, "presence": { "const": "PRESENT" }, "mode": { "enum": ["100644", "100755"] }, "length": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/hash" } } },
      { "type": "object", "additionalProperties": false, "required": ["path", "presence"], "properties": { "path": { "$ref": "#/$defs/path" }, "presence": { "const": "ABSENT" } } }
    ] }
  }
}
