{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomasweidner/flashgate-mcp/Governance/finding-correction-completion.schema.json",
  "title": "FlashGate finding-correction handoff completion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "profile", "transitionType", "status", "findingIds", "reviewStatus", "readyToExecute", "classicReviewReady", "commitAuthorized", "fullCompletionReexecuted", "fullMatrixRunCount", "productionRunInvocationCount", "automaticRetryCount", "packageWriteAttemptCount", "materialCorrectionCycleCount", "validationExecutionCount", "infrastructureOrInvocationFailureCount", "observedWarningCount", "resolvedWarningCount", "openWarningCount", "warningCount", "failureCount", "nextAction"],
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 1 } }, "required": ["schemaVersion"] },
      "then": {
        "properties": {
          "status": { "const": "ZIP_FREE_READY_TO_EXECUTE" },
          "readyToExecute": { "const": true },
          "classicReviewReady": { "const": false },
          "packageWriteAttemptCount": { "const": 0 },
          "nextAction": { "const": "READY_FOR_SINGLE_DELTA_REVIEW_PACKAGE_WRITE_AUTHORIZATION" }
        },
        "not": { "required": ["artifactLifecycleState"] }
      }
    },
    {
      "if": { "properties": { "schemaVersion": { "const": 2 } }, "required": ["schemaVersion"] },
      "then": { "required": ["artifactLifecycleState"] }
    },
    {
      "if": { "properties": { "artifactLifecycleState": { "const": "ZIP_FREE_READY_TO_EXECUTE" } }, "required": ["artifactLifecycleState"] },
      "then": {
        "properties": {
          "status": { "const": "ZIP_FREE_READY_TO_EXECUTE" },
          "readyToExecute": { "const": true },
          "classicReviewReady": { "const": false },
          "packageWriteAttemptCount": { "const": 0 },
          "nextAction": { "const": "READY_FOR_SINGLE_DELTA_REVIEW_PACKAGE_WRITE_AUTHORIZATION" }
        }
      }
    },
    {
      "if": { "properties": { "artifactLifecycleState": { "const": "FINAL_REVIEW_PACKAGE" } }, "required": ["artifactLifecycleState"] },
      "then": {
        "properties": {
          "status": { "const": "FINAL_REVIEW_PACKAGE" },
          "readyToExecute": { "const": false },
          "classicReviewReady": { "const": true },
          "packageWriteAttemptCount": { "const": 1 },
          "nextAction": { "const": "FOCUSED_INDEPENDENT_DELTA_REVIEW" }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "artifactLifecycleState": { "enum": ["ZIP_FREE_READY_TO_EXECUTE", "FINAL_REVIEW_PACKAGE"] },
    "taskId": { "type": "string", "pattern": "^BL-(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2,})$" },
    "profile": { "const": "FINDING_CORRECTION" },
    "transitionType": { "const": "BUNDLED_CORRECTION_TO_FOCUSED_DELTA_REVIEW" },
    "status": { "enum": ["ZIP_FREE_READY_TO_EXECUTE", "FINAL_REVIEW_PACKAGE"] },
    "findingIds": { "$ref": "#/$defs/findingIds" },
    "previousIndependentReviewOutcomeSha256": { "$ref": "#/$defs/outcomeHash" },
    "reviewStatus": { "const": "AWAITING_FOCUSED_INDEPENDENT_DELTA_REVIEW" },
    "readyToExecute": { "type": "boolean" },
    "classicReviewReady": { "type": "boolean" },
    "commitAuthorized": { "const": false },
    "fullCompletionReexecuted": { "const": false },
    "fullMatrixRunCount": { "const": 1 },
    "productionRunInvocationCount": { "const": 1 },
    "automaticRetryCount": { "const": 0 },
    "packageWriteAttemptCount": { "enum": [0, 1] },
    "materialCorrectionCycleCount": { "type": "integer", "minimum": 0, "maximum": 12 },
    "validationExecutionCount": { "type": "integer", "minimum": 1 },
    "infrastructureOrInvocationFailureCount": { "type": "integer", "minimum": 0 },
    "observedWarningCount": { "type": "integer", "minimum": 0 },
    "resolvedWarningCount": { "type": "integer", "minimum": 0 },
    "openWarningCount": { "const": 0 },
    "warningCount": { "const": 0 },
    "failureCount": { "const": 0 },
    "nextAction": { "enum": ["READY_FOR_SINGLE_DELTA_REVIEW_PACKAGE_WRITE_AUTHORIZATION", "FOCUSED_INDEPENDENT_DELTA_REVIEW"] }
  },
  "$defs": {
    "outcomeHash": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "findingIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^BL-(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2,})-REV-0*[1-9][0-9]*$" } }
  }
}
