{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomasweidner/flashgate-mcp/Governance/finding-regression-matrix.schema.json",
  "title": "FlashGate finding regression matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureCount",
    "fixtureResult",
    "validatorPath",
    "findings"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "fixtureCount": { "type": "integer", "minimum": 1 },
    "fixtureResult": { "const": "PASS" },
    "validatorPath": { "type": "string", "minLength": 1 },
    "finalFocusedValidationEvidence": { "$ref": "#/$defs/finalFocusedValidationEvidence" },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "finalFocusedValidationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceArtifact", "sourceEvidenceSha256", "sourceEvidenceLength", "status", "selected", "passed", "failed"],
      "properties": {
        "sourceArtifact": { "const": "focused-validation-result.json" },
        "sourceEvidenceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourceEvidenceLength": { "type": "integer", "minimum": 1 },
        "status": { "const": "PASS" },
        "selected": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 1 },
        "failed": { "const": 0 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "previousStatus", "status", "disposition", "correction", "affectedPaths", "evidenceReferences", "regressionTests"],
      "properties": {
        "id": { "$ref": "#/$defs/findingId" },
        "severity": { "enum": ["BLOCKER", "MAJOR", "MINOR", "NOTE"] },
        "previousStatus": { "enum": ["OPEN", "PARTIALLY_CLOSED", "PARTIALLY_CLOSED_CORRECTION_REQUIRED"] },
        "status": { "const": "CORRECTED_PENDING_DELTA" },
        "disposition": { "const": "CORRECTED" },
        "correction": { "type": "string", "minLength": 1 },
        "affectedPaths": { "$ref": "#/$defs/strings" },
        "evidenceReferences": { "$ref": "#/$defs/strings" },
        "publicationRegressionEvidence": { "$ref": "#/$defs/publicationEvidenceBinding" },
        "regressionTests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/regressionTest" }
        }
      }
    },
    "findingId": {
      "type": "string",
      "pattern": "^BL[0-9]{3}(?:-BL[0-9]{3})?(?:-[A-Z][A-Z0-9]*)*-REV-[0-9]{3}$"
    },
    "strings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "publicationEvidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "sha256", "matrixId", "caseIds"],
      "properties": {
        "artifact": { "const": "publication-regression-evidence.json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "matrixId": { "type": "string", "minLength": 1 },
        "caseIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^GHP-[A-Z0-9_-]+$" } }
      }
    },
    "regressionTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "validatorPath", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "const": "PASS" },
        "validatorPath": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
