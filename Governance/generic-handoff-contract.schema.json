{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomasweidner/flashgate-mcp/Governance/generic-handoff-contract.schema.json",
  "title": "FlashGate generic handoff contract",
  "type": "object",
  "allOf": [
    { "if": { "properties": { "classicReviewReady": { "const": true } }, "required": ["classicReviewReady"] }, "then": { "properties": { "status": { "const": "CLASSIC_REVIEW_READY" } } } },
    { "if": { "properties": { "classicReviewReady": { "const": false } }, "required": ["classicReviewReady"] }, "then": { "properties": { "status": { "const": "NOT_CLASSIC_REVIEW_READY" } } } },
    { "if": { "properties": { "profile": { "const": "GENERIC_COMMIT_PREPARATION" }, "classicReviewReady": { "const": true } }, "required": ["profile", "classicReviewReady"] }, "then": { "properties": { "reviewStatus": { "const": "PASS" } } } },
    { "if": { "properties": { "profile": { "const": "GENERIC_COMMIT_PREPARATION" } }, "required": ["profile"] }, "then": { "properties": { "transitionType": { "const": "COMMIT_PREPARATION_TO_COMMIT_APPROVAL" }, "reviewStatus": { "enum": ["PASS", "FAIL"] }, "branch": { "type": "string", "minLength": 1 }, "taskPatchSha256": { "$ref": "#/$defs/hash" }, "currentDeltaSha256": { "$ref": "#/$defs/hash" } }, "not": { "anyOf": [{ "required": ["fullCompletionEvidenceSha256"] }, { "required": ["fullCompletionResultSha256"] }, { "required": ["executionEnvelopeSha256"] }] } } },
    { "if": { "properties": { "profile": { "const": "IMPLEMENTATION_TO_INDEPENDENT_FULL_REVIEW" } }, "required": ["profile"] }, "then": { "required": ["fullCompletionEvidenceSha256", "fullCompletionResultSha256", "executionEnvelopeSha256"], "properties": { "transitionType": { "const": "IMPLEMENTATION_TO_INDEPENDENT_FULL_REVIEW" }, "reviewStatus": { "const": "NOT_PERFORMED" }, "branch": { "type": "string" }, "taskPatchSha256": { "$ref": "#/$defs/hash" }, "currentDeltaSha256": { "$ref": "#/$defs/hash" } } } },
    { "if": { "properties": { "profile": { "const": "EVIDENCE_ONLY_FOCUSED_REVIEW" } }, "required": ["profile"] }, "then": { "properties": { "transitionType": { "const": "EVIDENCE_ONLY_TO_FOCUSED_REVIEW" }, "taskPatchSha256": { "type": "null" }, "currentDeltaSha256": { "type": "null" } } } },
    { "if": { "properties": { "profile": { "const": "POST_MERGE_CLOSURE" } }, "required": ["profile"] }, "then": { "properties": { "transitionType": { "const": "POST_MERGE_TO_DOCUMENTATION_CLOSURE" }, "taskPatchSha256": { "type": "null" }, "currentDeltaSha256": { "type": "null" } } } }
  ],
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "repository", "baselineCommit", "currentCommit", "branch", "transitionType", "profile", "status", "classicReviewReady", "findingIds", "reviewStatus", "commitAuthorized", "scopeInventorySha256", "taskPatchSha256", "currentDeltaSha256", "allowedDeltaPaths", "excludedDeltaPaths", "nextAction"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "pattern": "^BL-[0-9]{3}$" },
    "repository": { "const": "https://github.com/thomasweidner/flashgate-mcp.git" },
    "baselineCommit": { "$ref": "#/$defs/commit" },
    "currentCommit": { "$ref": "#/$defs/commit" },
    "branch": { "type": "string" },
    "transitionType": { "enum": ["COMMIT_PREPARATION_TO_COMMIT_APPROVAL", "IMPLEMENTATION_TO_INDEPENDENT_FULL_REVIEW", "EVIDENCE_ONLY_TO_FOCUSED_REVIEW", "POST_MERGE_TO_DOCUMENTATION_CLOSURE"] },
    "profile": { "enum": ["GENERIC_COMMIT_PREPARATION", "IMPLEMENTATION_TO_INDEPENDENT_FULL_REVIEW", "EVIDENCE_ONLY_FOCUSED_REVIEW", "POST_MERGE_CLOSURE"] },
    "status": { "enum": ["CLASSIC_REVIEW_READY", "NOT_CLASSIC_REVIEW_READY"] },
    "classicReviewReady": { "type": "boolean" },
    "findingIds": { "$ref": "#/$defs/findingIds" },
    "reviewStatus": { "enum": ["PASS", "FAIL", "NOT_PERFORMED"] },
    "commitAuthorized": { "const": false },
    "scopeInventorySha256": { "$ref": "#/$defs/hash" },
    "taskPatchSha256": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "currentDeltaSha256": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "allowedDeltaPaths": { "$ref": "#/$defs/pathArray" },
    "excludedDeltaPaths": { "$ref": "#/$defs/pathArray" },
    "nextAction": { "type": "string", "minLength": 1 },
    "fullCompletionEvidenceSha256": { "$ref": "#/$defs/hash" },
    "fullCompletionResultSha256": { "$ref": "#/$defs/hash" },
    "executionEnvelopeSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\|.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "pathArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "findingIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" } }
  }
}
