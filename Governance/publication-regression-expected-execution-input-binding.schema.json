{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomasweidner/flashgate-mcp/Governance/publication-regression-expected-execution-input-binding.schema.json",
  "title": "FlashGate publication regression expected execution input binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "matrixId", "executionInputBinding"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "matrixId": { "type": "string", "minLength": 1 },
    "executionInputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrixDefinitionArtifact", "matrixDefinitionSha256", "sourceBindings", "dependencyBindings"],
      "properties": {
        "matrixDefinitionArtifact": { "const": "Governance/publication-regression-matrix-catalog.json" },
        "matrixDefinitionSha256": { "$ref": "#/$defs/sha256" },
        "sourceBindings": { "$ref": "#/$defs/fileBindings" },
        "dependencyBindings": { "$ref": "#/$defs/fileBindings" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\|.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "fileBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  }
}
