{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomasweidner/flashgate-mcp/Governance/generic-validation-summary.schema.json",
  "title": "FlashGate generic validation summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "profile", "result", "checks", "warningCount", "failureCount"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "pattern": "^BL-[0-9]{3}$" },
    "profile": { "const": "GENERIC_COMMIT_PREPARATION" },
    "result": { "enum": ["PASS", "FAIL"] },
    "checks": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "result"], "properties": { "id": { "type": "string", "minLength": 1 }, "result": { "enum": ["PASS", "FAIL"] } } } },
    "warningCount": { "type": "integer", "minimum": 0 },
    "failureCount": { "type": "integer", "minimum": 0 }
  }
}
