{
  "schemaVersion": "1.0",
  "server": {
    "name": "flashgate",
    "transport": "stdio",
    "protocol": "MCP JSON-RPC",
    "toolResultContract": {
      "wireEnvelope": "CallToolResult",
      "content": "ordered payload blocks or a compact metadata compatibility block",
      "structuredContent": "structured object described by each tool resultSchema",
      "runtimeOutputSchema": true
    },
    "rootConfiguration": {
      "tomlKey": "files.default_id",
      "rootPathTomlKey": "files.roots.<id>.path",
      "pathMode": "relative tool paths with an explicit configured root ID for each operand",
      "required": true,
      "rootPathMustBeAbsolute": true,
      "rootIdPattern": "^[a-z][a-z0-9_]{0,63}$",
      "maximumRoots": 256,
      "codexReadOnlyExampleRequires": {
        "tomlKey": "files.read_only",
        "value": true
      }
    }
  },
  "tools": [
    {
      "name": "list_directory",
      "title": "List Directory",
      "description": "Lists files and directories below the selected root.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "root_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Relative directory path. Use '.' for the root directory."
          }
        },
        "required": [
          "root_id",
          "path"
        ]
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "isDir": {
                  "type": "boolean"
                },
                "size": {
                  "type": "integer"
                }
              },
              "required": [
                "name",
                "isDir",
                "size"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "entries"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "read_file",
      "title": "Read File",
      "description": "Reads a UTF-8 text file below the selected root.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "required": [
          "root_id",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "root_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Relative file path."
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum number of bytes to read. Defaults to the configured maximum file size."
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "size": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "size"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_path_info",
      "title": "Get Path Info",
      "description": "Returns existence and metadata for a file or directory below the selected root.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "required": [
          "root_id",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "root_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Relative file or directory path."
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "exists": {
                "const": false
              }
            },
            "required": [
              "path",
              "exists"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "exists": {
                "const": true
              },
              "name": {
                "type": "string"
              },
              "isDir": {
                "type": "boolean"
              },
              "size": {
                "type": "integer"
              }
            },
            "required": [
              "path",
              "exists",
              "name",
              "isDir",
              "size"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    {
      "name": "write_file",
      "title": "Write File",
      "description": "Writes a text file below the selected root.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "required": [
          "root_id",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "root_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Relative file path."
          },
          "content": {
            "type": "string",
            "description": "Text content to write. An empty string is allowed."
          },
          "overwrite": {
            "type": "boolean",
            "description": "Whether an existing file may be overwritten. Defaults to false."
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "written": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "size",
          "written"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "create_directory",
      "title": "Create Directory",
      "description": "Creates a directory and any missing parents below the selected root.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "required": [
          "root_id",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "root_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Relative directory path."
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "created": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "created"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "delete_path",
      "title": "Delete Path",
      "description": "Deletes a file or directory below the selected root.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "required": [
          "root_id",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "root_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Relative file or directory path."
          },
          "recursive": {
            "type": "boolean",
            "description": "Whether a non-empty directory may be deleted recursively. Defaults to false."
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "deleted": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "deleted"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "copy_path",
      "title": "Copy Path",
      "description": "Copies a file within one selected root. Directory copy is not supported.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "required": [
          "source_root_id",
          "source",
          "target_root_id",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "source_root_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "target_root_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "Relative source file path."
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "Relative target file path."
          },
          "overwrite": {
            "type": "boolean",
            "description": "Whether an existing target may be overwritten. Defaults to false."
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "copied": {
            "type": "boolean"
          }
        },
        "required": [
          "source",
          "target",
          "copied"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "move_path",
      "title": "Move Path",
      "description": "Moves or renames a file or directory on the same volume within one selected root.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "required": [
          "source_root_id",
          "source",
          "target_root_id",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "source_root_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "target_root_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "Relative source file or directory path."
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "Relative target file or directory path."
          },
          "overwrite": {
            "type": "boolean",
            "description": "Whether an existing target may be overwritten. Defaults to false."
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "moved": {
            "type": "boolean"
          }
        },
        "required": [
          "source",
          "target",
          "moved"
        ],
        "additionalProperties": false
      }
    }
  ],
  "commonErrors": [
    {
      "code": -32602,
      "name": "Invalid params",
      "description": "Malformed arguments, missing required arguments, invalid paths, or invalid filesystem operations."
    }
  ]
}
